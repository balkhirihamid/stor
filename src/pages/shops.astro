---
import Layout from '../layouts/Layout.astro';
import Navbar from '../ui/navbar.astro';
import Footer from '../ui/footer.astro';
import { products } from "../data/products";

//export const prerender = false;
const search = Astro.url.searchParams.get("search")?.trim().toLowerCase() || "";

const sp = search ? products.filter((product) => {
    const searchableText = [
      product.name,
      product.category,
      product.description,
      ...(product.tags ?? []),
    ].filter(Boolean).join(" ").toLowerCase();

    return searchableText.includes(search);
  }): products;
---
<Layout>
<Navbar />

<main class="min-h-screen bg-gray-50">
  <!-- Page Header -->
  <section class="border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="mb-2 text-sm font-medium text-indigo-600"> Shop </p>
          <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"> All Products </h1>
          <p class="mt-2 max-w-xl text-sm text-gray-500"> Discover our latest collection and find something you love. </p>
        </div>

        <div class="flex items-center gap-3">
          
          <!-- <div class="relative">
            <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="csr-search"
              type="text"
              placeholder="Search products..."
              value={search}
              class="h-10 w-44 rounded-lg border border-gray-200 bg-white pl-9 pr-8 text-sm text-gray-700 outline-none transition focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 sm:w-56"
            />
            <button id="csr-search-clear" class="absolute right-2 top-1/2 -translate-y-1/2 hidden text-gray-400 hover:text-gray-600" aria-label="Clear search">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>-->

          <!-- Sort -->
          <div class="flex items-center gap-3">
            <span class="hidden text-sm text-gray-500 sm:block"> Sort by </span>
            <select id="csr-sort" class="h-10 rounded-lg border border-gray-200 bg-white px-3 text-sm text-gray-700 outline-none transition focus:border-indigo-500">
              <option value="featured">Featured</option>
              <option value="newest">Newest</option>
              <option value="priceLowHigh">Price: Low to High</option>
              <option value="priceHighLow">Price: High to Low</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Shop -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between lg:hidden mb-6">
      <button id="filter-button" class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10M10 18h4" />
        </svg>
        Filters
        <span id="filter-badge" class="hidden flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[10px] font-bold text-white">0</span>
      </button>
      <span id="count-mobile" class="text-sm text-gray-500"> {sp.length} products</span>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_minmax(0,1fr)]">

      <!-- Sidebar -->
      <aside id="filters" class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <!-- Clear Filters -->
          <button id="clear-filters" class="hidden w-full rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-600 hover:bg-indigo-100 transition">
            Clear all filters
          </button>

          <!-- Categories -->
          <div class="rounded-xl border border-gray-200 bg-white p-5">
            <h2 class="text-sm font-semibold text-gray-900"> Categories </h2>
            <div class="mt-4 space-y-3">
              <label class="flex cursor-pointer items-center gap-3">
                <input type="checkbox" data-category="Clothing" class="csr-category h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                <span class="text-sm text-gray-600"> Clothing </span>
              </label>
              <label class="flex cursor-pointer items-center gap-3">
                <input type="checkbox" data-category="Shoes" class="csr-category h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                <span class="text-sm text-gray-600"> Shoes </span>
              </label>
              <label class="flex cursor-pointer items-center gap-3">
                <input type="checkbox" data-category="Accessories" class="csr-category h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                <span class="text-sm text-gray-600"> Accessories </span>
              </label>
            </div>
          </div>

          <!-- Price -->
          <div class="rounded-xl border border-gray-200 bg-white p-5">
            <h2 class="text-sm font-semibold text-gray-900"> Price </h2>
            <div class="mt-4 space-y-3">
              <label class="flex cursor-pointer items-center gap-3">
                <input type="radio" name="price" value="under50" class="csr-price h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                <span class="text-sm text-gray-600"> Under $50 </span>
              </label>
              <label class="flex cursor-pointer items-center gap-3">
                <input type="radio" name="price" value="50to100" class="csr-price h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                <span class="text-sm text-gray-600"> $50 - $100 </span>
              </label>
              <label class="flex cursor-pointer items-center gap-3">
                <input type="radio" name="price" value="over100" class="csr-price h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                <span class="text-sm text-gray-600"> $100+ </span>
              </label>
            </div>
          </div>

          <!-- Availability -->
          <div class="rounded-xl border border-gray-200 bg-white p-5">
            <h2 class="text-sm font-semibold text-gray-900"> Availability </h2>
            <label class="mt-4 flex cursor-pointer items-center gap-3">
              <input type="checkbox" id="csr-instock" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
              <span class="text-sm text-gray-600"> In stock </span>
            </label>
          </div>
        </div>
      </aside>

      <!-- Products -->
      <div>
        <div class="mb-5 hidden items-center justify-between lg:flex">
          <p id="count-desktop" class="text-sm text-gray-500">
            Showing <span id="count-num" class="font-medium text-gray-900">{sp.length}</span> products
          </p>
        </div>

        <!-- No Results -->
        <div id="no-results" class="hidden flex-col items-center justify-center py-20 text-center">
          <svg class="h-16 w-16 text-gray-300 mb-4" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <h3 class="text-lg font-medium text-gray-900">No products found</h3>
          <p class="mt-2 text-sm text-gray-500">Try adjusting your search or filter criteria</p>
          <button id="no-results-clear" class="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition">
            Clear all filters
          </button>
        </div>

        <div id="products-grid" class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
          {sp.map((product) => (
            <article class="product-card group min-w-0"
              data-id={product.id}
              data-name={product.name}
              data-category={product.category}
              data-description={product.description}
              data-price={product.price}
              data-old-price={product.oldPrice || ""}
              data-tags={(product.tags ?? []).join(",")}
              data-image={product.images[0]}
            >
              <!-- Image -->
              <a href={`${import.meta.env.BASE_URL}shop/${product.id}`} class="relative block aspect-square overflow-hidden rounded-xl bg-gray-100">
                <img
                  src={product.images[0]}
                  alt={product.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />

                {product.oldPrice && (
                  <span class="sale-badge absolute left-3 top-3 rounded-full bg-red-500 px-2.5 py-1 text-xs font-semibold text-white"> Sale </span>
                )}

                <!-- Wishlist -->
                <button
                  class="wishlist-btn absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-gray-600 shadow-sm backdrop-blur transition hover:bg-white hover:text-red-500"
                  aria-label={`Add ${product.name} to wishlist`}
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.8 8.7c0 5.5-8.8 10.3-8.8 10.3S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.1a4.7 4.7 0 0 1 8.8 2.6Z" />
                  </svg>
                </button>
              </a>

              <!-- Product Info -->
              <div class="pt-4">
                <p class="text-xs font-medium text-gray-400 product-category-text"> {product.category} </p>
                <h2 class="mt-1 truncate text-sm font-medium text-gray-900">
                  <a href={`${import.meta.env.BASE_URL}shop/${product.id}`} class="transition hover:text-indigo-600"> {product.name} </a>
                </h2>

                <div class="mt-2 flex items-center gap-2">
                  <span class="text-sm font-bold text-gray-900 product-price-text"> ${product.price.toFixed(2)} </span>
                  {product.oldPrice && (
                    <span class="text-xs text-gray-400 line-through product-old-price-text"> ${product.oldPrice.toFixed(2)} </span>
                  )}
                </div>

                <!-- Add to Cart -->
                <button class="mt-3 flex w-full items-center justify-center gap-2 rounded-lg bg-gray-900 px-3 py-2.5 text-xs font-semibold text-white transition hover:bg-indigo-600 active:scale-[0.98]">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" />
                    <circle cx="10" cy="20" r="1" />
                    <circle cx="18" cy="20" r="1" />
                  </svg>
                  Add to cart
                </button>
              </div>
            </article>
          ))}
        </div>

        <!-- Pagination -->
        <div class="mt-12 flex items-center justify-center gap-2">
          <button class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:bg-gray-50" aria-label="Previous page">
            <svg class="h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-sm font-semibold text-white"> 1 </button>
          <button class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-sm text-gray-600 hover:bg-gray-50"> 2 </button>
          <button class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-sm text-gray-600 hover:bg-gray-50"> 3 </button>
          <button class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:bg-gray-50" aria-label="Next page">
            <svg class="h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
</main>
<Footer/>

<script>
  // We read product data from the DOM attributes instead
  const cards = document.querySelectorAll('.product-card');
  const allProductsData = Array.from(cards).map(card => ({
    el: card,
    id: card.dataset.id,
    name: card.dataset.name || '',
    category: card.dataset.category || '',
    description: card.dataset.description || '',
    price: parseFloat(card.dataset.price) || 0,
    oldPrice: card.dataset.oldPrice ? parseFloat(card.dataset.oldPrice) : null,
    tags: (card.dataset.tags || '').split(',').filter(Boolean),
    inStock: card.dataset.inStock === 'true',
    image: card.dataset.image || '',
  }));

  // ===== DOM Elements =====
  const searchInput = document.getElementById('csr-search');
  const searchClear = document.getElementById('csr-search-clear');
  const sortSelect = document.getElementById('csr-sort');
  const categoryCheckboxes = document.querySelectorAll('.csr-category');
  const priceRadios = document.querySelectorAll('.csr-price');
  const inStockCheckbox = document.getElementById('csr-instock');
  const filterButton = document.getElementById('filter-button');
  const filtersPanel = document.getElementById('filters');
  const filterBadge = document.getElementById('filter-badge');
  const clearFiltersBtn = document.getElementById('clear-filters');
  const noResultsClear = document.getElementById('no-results-clear');
  const countNum = document.getElementById('count-num');
  const countMobile = document.getElementById('count-mobile');
  const productsGrid = document.getElementById('products-grid');
  const noResults = document.getElementById('no-results');

  // ===== Debounce utility =====
  function debounce(fn, delay) {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  // ===== Core filter + render function =====
  function applyFilters() {
    const searchTerm = ((searchInput as HTMLInputElement)?.value || '').trim().toLowerCase();
    const selectedCategories = Array.from(categoryCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.dataset.category);
    const priceRange = document.querySelector('.csr-price:checked')?.value || 'all';
    const inStockOnly = inStockCheckbox?.checked || false;
    const sortBy = sortSelect?.value || 'featured';

    // Filter products
    let filtered = allProductsData.filter(p => {
      // Search
      if (searchTerm) {
        const searchableText = [p.name, p.category, p.description, ...p.tags]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();
        if (!searchableText.includes(searchTerm)) return false;
      }

      // Category
      if (selectedCategories.length > 0 && !selectedCategories.includes(p.category)) {
        return false;
      }

      // Price
      if (priceRange !== 'all') {
        if (priceRange === 'under50' && p.price >= 50) return false;
        if (priceRange === '50to100' && (p.price < 50 || p.price > 100)) return false;
        if (priceRange === 'over100' && p.price <= 100) return false;
      }

      // In stock
      if (inStockOnly && !p.inStock) return false;

      return true;
    });

    // Sort
    if (sortBy === 'newest') {
      filtered = [...filtered].reverse();
    } else if (sortBy === 'priceLowHigh') {
      filtered = [...filtered].sort((a, b) => a.price - b.price);
    } else if (sortBy === 'priceHighLow') {
      filtered = [...filtered].sort((a, b) => b.price - a.price);
    }

    // ===== Update DOM =====
    const filteredIds = new Set(filtered.map(p => p.id));

    // Show/hide cards
    allProductsData.forEach(p => {
      p.el.style.display = filteredIds.has(p.id) ? '' : 'none';
    });

    // Reorder cards in DOM based on sort
    if (sortBy !== 'featured') {
      filtered.forEach(p => {
        productsGrid?.appendChild(p.el);
      });
    }

    // Update counts
    const count = filtered.length;
    if (countNum) countNum.textContent = count.toFixed(2);
    if (countMobile) countMobile.textContent = `${count} products`;

    // Show/hide no results
    if (count === 0) {
      productsGrid?.classList.add('hidden');
      noResults?.classList.remove('hidden');
      noResults?.classList.add('flex');
    } else {
      productsGrid?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      noResults?.classList.remove('flex');
    }

    // Search clear button
    if (searchClear) {
      searchClear.classList.toggle('hidden', !searchTerm);
    }

    // Filter badge
    const activeFilterCount = selectedCategories.length + (priceRange !== 'all' ? 1 : 0) + (inStockOnly ? 1 : 0);
    if (filterBadge) {
      if (activeFilterCount > 0) {
        filterBadge.textContent = activeFilterCount.toString();
        filterBadge.classList.remove('hidden');
      } else {
        filterBadge.classList.add('hidden');
      }
    }

    // Clear filters button
    const hasActiveFilters = searchTerm || selectedCategories.length > 0 || priceRange !== 'all' || inStockOnly;
    if (clearFiltersBtn) {
      clearFiltersBtn.classList.toggle('hidden', !hasActiveFilters);
    }
  }

  // ===== Clear all filters =====
  function clearAllFilters() {
    if (searchInput) searchInput.value = '';
    categoryCheckboxes.forEach(cb => cb.checked = false);
    priceRadios.forEach(r => r.checked = false);
    if (inStockCheckbox) inStockCheckbox.checked = false;
    if (sortSelect) sortSelect.value = 'featured';
    applyFilters();
  }

  // ===== Event Listeners =====

  // Search with debounce
  if (searchInput) {
    searchInput.addEventListener('input', debounce(applyFilters, 250));
  }

  // Search clear
  if (searchClear) {
    searchClear.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      applyFilters();
    });
  }

  // Sort
  if (sortSelect) {
    sortSelect.addEventListener('change', applyFilters);
  }

  // Categories
  categoryCheckboxes.forEach(cb => {
    cb.addEventListener('change', applyFilters);
  });

  // Price
  priceRadios.forEach(r => {
    r.addEventListener('change', applyFilters);
  });

  // In stock
  if (inStockCheckbox) {
    inStockCheckbox.addEventListener('change', applyFilters);
  }

  // Mobile filter toggle
  if (filterButton && filtersPanel) {
    filterButton.addEventListener('click', () => {
      filtersPanel.classList.toggle('hidden');
    });
  }

  // Clear filters buttons
  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', clearAllFilters);
  }
  if (noResultsClear) {
    noResultsClear.addEventListener('click', clearAllFilters);
  }

  // Wishlist toggle (bonus CSR)
  document.querySelectorAll('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const svg = btn.querySelector('svg');
      const isActive = btn.classList.toggle('active-wishlist');
      if (isActive) {
        btn.classList.remove('bg-white/90', 'text-gray-600');
        btn.classList.add('bg-red-50', 'text-red-500');
        svg?.setAttribute('fill', 'currentColor');
      } else {
        btn.classList.add('bg-white/90', 'text-gray-600');
        btn.classList.remove('bg-red-50', 'text-red-500');
        svg?.setAttribute('fill', 'none');
      }
    });
  });

  // Initialize on page load
  applyFilters();
</script>
</Layout>
