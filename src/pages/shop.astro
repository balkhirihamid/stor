---
import Layout from '../layouts/Layout.astro';
import Navbar from '../ui/navbar.astro';
import Footer from '../ui/footer.astro';
import { products } from "../data/products";

const search = Astro.url.searchParams.get("search")?.trim().toLowerCase() || "";

const sp = search ? products.filter((product) => {
    const searchableText = [
      product.name,
      product.category,
      product.description,
      ...(product.tags ?? []),
    ].filter(Boolean).join(" ").toLowerCase();

    return searchableText.includes(search);
  }): products;
---
<Layout>
<Navbar />

<main class="min-h-screen bg-gray-50">

  <!-- Page Header -->
  <section class="border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

        <div>
          <p class="mb-2 text-sm font-medium text-indigo-600">
            Shop
          </p>

          <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            All Products
          </h1>

          <p class="mt-2 max-w-xl text-sm text-gray-500">
            Discover our latest collection and find something you love.
          </p>
        </div>

        <!-- Sort -->
        <div class="flex items-center gap-3">
          <span class="hidden text-sm text-gray-500 sm:block">
            Sort by
          </span>

          <select
            class="h-10 rounded-lg border border-gray-200 bg-white px-3 text-sm text-gray-700 outline-none transition focus:border-indigo-500"
          >
            <option>Featured</option>
            <option>Newest</option>
            <option>Price: Low to High</option>
            <option>Price: High to Low</option>
          </select>
        </div>

      </div>

    </div>
  </section>


  <!-- Shop -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="flex items-center justify-between lg:hidden mb-6">

      <button
        id="filter-button"
        class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M7 12h10M10 18h4"
          />
        </svg>

        Filters
      </button>

      <span class="text-sm text-gray-500">
        {sp.length} sp
      </span>

    </div>


    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_minmax(0,1fr)]">

      <!-- Sidebar -->
      <aside
        id="filters"
        class="hidden lg:block"
      >

        <div class="sticky top-24 space-y-6">

          <!-- Categories -->
          <div class="rounded-xl border border-gray-200 bg-white p-5">

            <h2 class="text-sm font-semibold text-gray-900">
              Categories
            </h2>

            <div class="mt-4 space-y-3">

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <span class="text-sm text-gray-600">
                  Clothing
                </span>
              </label>

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <span class="text-sm text-gray-600">
                  Shoes
                </span>
              </label>

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <span class="text-sm text-gray-600">
                  Accessories
                </span>
              </label>

            </div>
          </div>


          <!-- Price -->
          <div class="rounded-xl border border-gray-200 bg-white p-5">

            <h2 class="text-sm font-semibold text-gray-900">
              Price
            </h2>

            <div class="mt-4 space-y-3">

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="price"
                  class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <span class="text-sm text-gray-600">
                  Under $50
                </span>
              </label>

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="price"
                  class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <span class="text-sm text-gray-600">
                  $50 - $100
                </span>
              </label>

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="price"
                  class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <span class="text-sm text-gray-600">
                  $100+
                </span>
              </label>

            </div>
          </div>


          <!-- Availability -->
          <div class="rounded-xl border border-gray-200 bg-white p-5">

            <h2 class="text-sm font-semibold text-gray-900">
              Availability
            </h2>

            <label class="mt-4 flex cursor-pointer items-center gap-3">
              <input
                type="checkbox"
                class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
              />

              <span class="text-sm text-gray-600">
                In stock
              </span>
            </label>

          </div>

        </div>

      </aside>


      <!-- sp -->
      <div>

        <div class="mb-5 hidden items-center justify-between lg:flex">

          <p class="text-sm text-gray-500">
            Showing <span class="font-medium text-gray-900">{sp.length}</span> products
          </p>

        </div>


        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
          {sp.map((product) => (

            <article class="group min-w-0">

              <!-- Image -->
              <a
                href={`${import.meta.env.BASE_URL}shop/${product.id}`}
                class="relative block aspect-square overflow-hidden rounded-xl bg-gray-100"
              >

                <img
                  src={product.images[0]}
                  alt={product.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />

                {product.oldPrice && (
                  <span class="absolute inset-s-3 top-3 rounded-full bg-red-500 px-2.5 py-1 text-xs font-semibold text-white">
                    Sale
                  </span>
                )}

                <!-- Wishlist -->
                <button
                  class="absolute inset-e-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-gray-600 shadow-sm backdrop-blur transition hover:bg-white hover:text-red-500"
                  aria-label={`Add ${product.name} to wishlist`}
                >
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M20.8 8.7c0 5.5-8.8 10.3-8.8 10.3S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.1a4.7 4.7 0 0 1 8.8 2.6Z"
                    />
                  </svg>
                </button>

              </a>


              <!-- Product Info -->
              <div class="pt-4">

                <p class="text-xs font-medium text-gray-400">
                  {product.category}
                </p>

                <h2 class="mt-1 truncate text-sm font-medium text-gray-900">
                  <a
                    href={`${import.meta.env.BASE_URL}shop/${product.id}`}
                    class="transition hover:text-indigo-600"
                  >
                    {product.name}
                  </a>
                </h2>


                <div class="mt-2 flex items-center gap-2">

                  <span class="text-sm font-bold text-gray-900">
                    ${product.price.toFixed(2)}
                  </span>

                  {product.oldPrice && (
                    <span class="text-xs text-gray-400 line-through">
                      ${product.oldPrice.toFixed(2)}
                    </span>
                  )}

                </div>


                <!-- Add to Cart -->
                <button
                  class="mt-3 flex w-full items-center justify-center gap-2 rounded-lg bg-gray-900 px-3 py-2.5 text-xs font-semibold text-white transition hover:bg-indigo-600 active:scale-[0.98]"
                >
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"
                    />
                    <circle cx="10" cy="20" r="1" />
                    <circle cx="18" cy="20" r="1" />
                  </svg>

                  Add to cart
                </button>

              </div>

            </article>

          ))}

        </div>


        <!-- Pagination -->
        <div class="mt-12 flex items-center justify-center gap-2">

          <button
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:bg-gray-50"
            aria-label="Previous page"
          >
            <svg
              class="h-4 w-4 rtl:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
            </svg>
          </button>

          <button class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-sm font-semibold text-white">
            1
          </button>

          <button class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-sm text-gray-600 hover:bg-gray-50">
            2
          </button>

          <button class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-sm text-gray-600 hover:bg-gray-50">
            3
          </button>

          <button
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:bg-gray-50"
            aria-label="Next page"
          >
            <svg
              class="h-4 w-4 rtl:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" />
            </svg>
          </button>

        </div>

      </div>

    </div>

  </section>

</main>
<Footer/>

<script>
  const filterButton = document.getElementById("filter-button");
  const filters = document.getElementById("filters");

  filterButton?.addEventListener("click", () => {
    filters?.classList.toggle("hidden");
  });
</script>
</Layout>
