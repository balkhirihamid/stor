---
import Layout from "../layouts/Layout.astro";
import { products, info } from "../data/products";
import Navbar from "../ui/navbar.astro";
import { IconBrandWhatsapp } from "@tabler/icons-astro"
---


<Layout
  title="Shopping Cart | SHOP."
  description="Review the products in your shopping cart before checkout."
  canonical="https://example.com/cart"
>
  <Navbar/>
  <main class="bg-gray-50">
    <!-- Cart -->
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <!-- Header -->
      <div>
        <p class="text-sm font-semibold text-indigo-600">
          Your cart
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
          Shopping Cart
        </h1>
      </div>
      <!-- Cart Content -->
      <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-3">
        <!-- Products -->
        <div class="lg:col-span-2">
          <div id="cart-items" class="space-y-4" >
            <!-- Cart items rendered by JavaScript -->
          </div>
          <!-- Empty Cart -->
          <div id="empty-cart" class="hidden rounded-xl border border-gray-200 bg-white px-6 py-16 text-center" >
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
              <svg class="h-7 w-7 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" />
                <circle cx="10" cy="20" r="1" />
                <circle cx="18" cy="20" r="1" />
              </svg>
            </div>
            <h2 class="mt-5 text-lg font-semibold text-gray-900">
              Your cart is empty
            </h2>
            <p class="mt-2 text-sm text-gray-500">
              Looks like you haven't added anything to your cart yet.
            </p>
            <a href="/shop" class="mt-6 inline-flex h-11 items-center justify-center rounded-lg bg-gray-900 px-6 text-sm font-semibold text-white transition hover:bg-gray-800" >
              Continue shopping
            </a>
          </div>
        </div>
        <!-- Summary -->
        <aside id="cart-summary" class="h-fit rounded-xl border border-gray-200 bg-white p-6">
          <h2 class="text-lg font-semibold text-gray-900">
            Order Summary
          </h2>
          <div class="mt-6 space-y-4">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500"> Subtotal </span>
              <span id="subtotal" class="font-medium text-gray-900"> $0.00 </span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500"> Shipping </span>
              <span id="shipping" class="font-medium text-gray-900"> $0.00 </span>
            </div>
            <div class="border-t border-gray-100 pt-4">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-gray-900"> Total </span>
                <span id="total" class="text-xl font-bold text-gray-900"> $0.00 </span>
              </div>
            </div>
          </div>
          <button id="checkout-button" type="button" class="mt-6 flex h-12 w-full items-center justify-center rounded-lg bg-indigo-600 px-6 text-sm font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:bg-gray-300" disabled >
            <svg xmlns="http://www.w3.org/2000/svg" width="35" height="24" viewBox="0 0 220 220">
              <g transform="translate(140 135)">
                <path fill="#FFFFFF" fill-rule="nonzero" d="M-19.4,-121.4 C-18.5,-116.7 -19.6,-101.4 -21.4,-92.8 C-24.4,-78.8 -34,-63.1 -44.8,-54.5 C-56.7,-45.1 -69.8,-40.4 -87.8,-39.3 L-98,-38.7 V-56.7 V-74.7 L-91.9,-75.4 C-84.5,-76.1 -75.4,-80.7 -70.6,-86 C-68.8,-88 -66.3,-92.3 -65.1,-95.5 C-62.5,-102.5 -60.6,-115.1 -61.4,-120.8 L-62,-125 H-41.1 H-20.1 Z M37.8,-75.1 C37.2,-64 33.5,-55.3 26.5,-48.6 C19.8,-42.1 13.1,-39.8 -0.9,-39.2 L-12.3,-38.8 L-11.8,-47.6 C-10.9,-62.6 -5.5,-72.7 4.8,-78.7 C11.4,-82.6 17.2,-83.9 28.4,-84 L38.3,-84.1 Z M-17.2,19.7 C-13.7,26.4 -8.2,29.4 1.1,29.8 C7.5,30.1 9.8,29.8 15.2,27.6 C18.7,26.2 21.9,25.4 22.3,25.8 C23.3,26.8 34.1,56.8 34.1,58.5 C34.1,60.3 23.4,65.4 15,67.7 C10.4,68.9 4.9,69.4 -4.4,69.4 C-15.9,69.4 -18.3,69.1 -25.4,66.6 C-45.1,59.9 -57.8,46.4 -63.1,26.3 C-64.9,19.6 -65.3,14.6 -65.7,-8.6 L-66.3,-35.7 L-61.5,-37.3 C-47.5,-42.1 -31.8,-55.3 -24.4,-68.5 L-20.5,-75.5 L-20,-30 C-19.5,14.9 -19.4,15.6 -17.2,19.7 Z"/>
              </g>
            </svg>
            Commander
          </button>
          <button id="whatsapp-cart-button" type="button" class="mt-3 flex h-11 w-full items-center justify-center rounded-lg border bg-green-600 text-sm font-semibold text-white transition hover:bg-green-700">
            <IconBrandWhatsapp class="mr-2" /> Commander
          </button>

          <!-- Client details shown when checkout is started -->
          <form id="checkout-form" class="mt-5 hidden space-y-3" novalidate>
            <h3 class="font-semibold text-gray-900">Your contact details</h3>
            <label class="block text-sm font-medium text-gray-700">
              Name
              <input name="name" autocomplete="name" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
            </label>
            <label class="block text-sm font-medium text-gray-700">
              Phone
              <input name="phone" type="tel" autocomplete="tel" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
            </label>
            <label class="block text-sm font-medium text-gray-700">
              Address
              <textarea name="address" autocomplete="street-address" required rows="2" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"></textarea>
            </label>
            <p id="checkout-message" class="hidden text-sm" role="status"></p>
            <button id="checkout-submit" type="submit" class="flex h-11 w-full items-center justify-center rounded-lg bg-green-600 px-6 text-sm font-semibold text-white transition hover:bg-green-700 disabled:cursor-wait disabled:opacity-60">
              Send order
            </button>
          </form>
          <!-- Shipping Notice -->
          <div class="mt-6 rounded-lg bg-gray-50 p-4">
            <div class="flex gap-3">
              <svg class="h-5 w-5 shrink-0 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v10H3zM14 10h4l3 3v4h-7z" />
                <circle cx="7" cy="19" r="1.5" />
                <circle cx="18" cy="19" r="1.5" />
              </svg>
              <p class="text-xs leading-5 text-gray-500"> Free shipping on orders over $50. </p>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ products, info }}> 
const CART_KEY = "shop_cart"; 
/* * Get cart safely */ 
function getCart() { try { const stored = localStorage.getItem(CART_KEY); if (!stored) { return []; } const parsed = JSON.parse(stored); if (!Array.isArray(parsed)) { return []; } return parsed; } catch { return []; } } 
/* * Save cart */ 
function saveCart(cart) { localStorage.setItem( CART_KEY, JSON.stringify(cart) ); window.dispatchEvent( new CustomEvent("cart-updated") ); } 
/* * Compare IDs safely. * * Works with: * 1 === 1 * "1" === "1" * 1 === "1" * "iphone-15" === "iphone-15" */ 
function sameId(a, b) { return String(a) === String(b); } 
/* * Format price */ 
function formatPrice(price) { const value = Number(price) || 0; return `$${value.toFixed(2)}`; } 
/* * Cart count */ 
function updateCartCount(cart) { const countElement = document.getElementById("itemsCount"); if (!countElement) { return; } const count = cart.reduce( (total, item) => { const quantity = Number(item?.quantity); return total + ( Number.isFinite(quantity) && quantity > 0 ? quantity : 0 ); }, 0 ); countElement.textContent = String(count); countElement.classList.toggle( "hidden", count === 0 ); } 
/* * Render cart */ 
function renderCart() { 
  const cartItemsElement = document.getElementById("cart-items"); 
  const emptyCartElement = document.getElementById("empty-cart"); 
  const summaryElement = document.getElementById("cart-summary"); 
  const subtotalElement = document.getElementById("subtotal"); 
  const shippingElement = document.getElementById("shipping"); 
  const totalElement = document.getElementById("total"); 
  const checkoutButton = document.getElementById("checkout-button"); 
  if ( !cartItemsElement || !emptyCartElement ) { return; } 
  let cart = getCart(); 
  /* * Remove invalid cart items */ 
  const validCart = cart.filter((item) => { const product = products.find( (product) => sameId(product.id, item?.id) ); return product && Number(item?.quantity) > 0; }); 
  /* * Save cleaned cart if necessary */ 
  if (validCart.length !== cart.length) { cart = validCart; saveCart(cart); } updateCartCount(cart); 
  
  /* * Empty cart */ 
  if (cart.length === 0) { cartItemsElement.innerHTML = ""; emptyCartElement.classList.remove( "hidden" ); summaryElement?.classList.add( "hidden" ); if (checkoutButton) { checkoutButton.disabled = true; } return; } emptyCartElement.classList.add( "hidden" ); summaryElement?.classList.remove( "hidden" ); 
  
  /* * Render products */ 
  let subtotal = 0; cartItemsElement.innerHTML = cart .map((item) => { const product = products.find( (product) => sameId(product.id, item.id) ); if (!product) { return ""; } const quantity = Math.max( 1, Number(item.quantity) || 1 ); const price = Number(product.price) || 0; const itemTotal = price * quantity; subtotal += itemTotal; 
  
  const image = product.images?.[0].startsWith("http") ? product.images?.[0] : `../${product.images?.[0]}`; return ` <article class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5" > <div class="flex gap-4"> <a href="../shop/${product.id}" class="h-24 w-24 shrink-0 overflow-hidden rounded-lg bg-gray-100 sm:h-28 sm:w-28" > <img src="${image}" alt="${product.name}" class="h-full w-full object-cover" loading="lazy" /> </a> <div class="min-w-0 flex-1"> <div class="flex items-start justify-between gap-3"> <div class="min-w-0"> <p class="text-xs font-medium text-indigo-600"> ${product.category} </p> <a href="../shop/${product.id}" class="mt-1 block truncate text-sm font-semibold text-gray-900 hover:text-indigo-600" > ${product.name} </a> <p class="mt-1 text-sm font-medium text-gray-900"> ${formatPrice(price)} </p> </div> <button type="button" data-remove="${product.id}" class="shrink-0 text-gray-400 transition hover:text-red-500" aria-label="Remove ${product.name}" > <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true" > <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18" /> </svg> </button> </div> <div class="mt-4 flex items-center justify-between"> <div class="flex h-9 items-center rounded-lg border border-gray-200"> <button type="button" data-decrease="${product.id}" class="flex h-full w-9 items-center justify-center text-gray-500 hover:text-gray-900" aria-label="Decrease quantity" > − </button> <span class="w-8 text-center text-sm font-semibold text-gray-900" > ${quantity} </span> <button type="button" data-increase="${product.id}" class="flex h-full w-9 items-center justify-center text-gray-500 hover:text-gray-900" aria-label="Increase quantity" > + </button> </div> <p class="text-sm font-bold text-gray-900"> ${formatPrice(itemTotal)} </p> </div> </div> </div> </article> `; }) .join(""); /* * Shipping */ const shipping = subtotal >= 50 ? 0 : 5; const total = subtotal + shipping; if (subtotalElement) { subtotalElement.textContent = formatPrice(subtotal); } if (shippingElement) { shippingElement.textContent = shipping === 0 ? "Free" : formatPrice(shipping); } if (totalElement) { totalElement.textContent = formatPrice(total); } if (checkoutButton) { checkoutButton.disabled = false; } } /* * Event delegation */ const cartItemsElement = document.getElementById("cart-items"); cartItemsElement?.addEventListener( "click", (event) => { const target = event.target; if (!(target instanceof Element)) { return; } const increaseButton = target.closest( "[data-increase]" ); const decreaseButton = target.closest( "[data-decrease]" ); const removeButton = target.closest( "[data-remove]" ); /* * Increase */ if (increaseButton) { const id = increaseButton.getAttribute( "data-increase" ); if (id === null) { return; } const cart = getCart(); const item = cart.find( (item) => sameId(item.id, id) ); if (item) { item.quantity = Math.max( 1, Number(item.quantity) || 1 ) + 1; saveCart(cart); renderCart(); } return; } /* * Decrease */ if (decreaseButton) { const id = decreaseButton.getAttribute( "data-decrease" ); if (id === null) { return; } const cart = getCart(); const item = cart.find( (item) => sameId(item.id, id) ); if (!item) { return; } const quantity = Number(item.quantity) || 1; if (quantity > 1) { item.quantity = quantity - 1; } else { const index = cart.indexOf(item); if (index !== -1) { cart.splice(index, 1); } } saveCart(cart); renderCart(); return; } /* * Remove */ if (removeButton) { const id = removeButton.getAttribute( "data-remove" ); if (id === null) { return; } const cart = getCart().filter( (item) => !sameId(item.id, id) ); saveCart(cart); renderCart(); } } ); /* WhatsApp destination: replace with the shop's full international number, digits only. */
  
  const CHECKOUT_ENDPOINT = "https://pro-max.org/api/webhook"; 

  function getOrderSummary() {
    const cart = getCart();
    const items = cart.map((item) => {
      const product = products.find((entry) => sameId(entry.id, item.id));
      if (!product) return null;
      const quantity = Math.max(1, Number(item.quantity) || 1);
      const price = Number(product.price) || 0;
      return { 
        id: product.id,
        name: product.name,
        quantity,
        price,
        subtotal: price * quantity,
      };
    }).filter(Boolean);

    const subtotal = items.reduce((sum, item) => sum + item.subtotal, 0);
    const shipping = subtotal >= 50 ? 0 : (items.length ? 5 : 0);
    return { items, subtotal, shipping, total: subtotal + shipping };
  }

  function makeWhatsAppMessage(order, client = null) {
    const lines = [
      "*Hello*\n\n",
        ...order.items.map((item, i) => "*"+(i+1)+"*•_`"+item.name+"`_ *"+item.quantity+"* * "+item.price+" = *"+formatPrice(item.subtotal)+"* \n\n"),
      "*`Subtotal: "+formatPrice(order.subtotal)+"`* \n",
      "*`Shipping: "+ (order.shipping === 0 ? "Free" : formatPrice(order.shipping)) +"`*\n",
      "*`Total: "+formatPrice(order.total)+"`*",
    ];

    if (client) {
      lines.push("", "Customer details:", `Name: ${client.name}`, `Phone: ${client.phone}`, `Address: ${client.address}`);
    }
    return lines.join("");
  }

  function openWhatsApp(message) {
    const url = `https://wa.me/${info.phone}?text=${encodeURIComponent(message)}`;
    window.open(url, "_blank", "noopener,noreferrer");
  }

  const whatsappCartButton = document.getElementById("whatsapp-cart-button");
  whatsappCartButton?.addEventListener("click", () => {
    const order = getOrderSummary();
    if (!order.items.length) return;
    openWhatsApp(makeWhatsAppMessage(order));
  });

  const checkoutForm = document.getElementById("checkout-form");
  const checkoutButton = document.getElementById("checkout-button");
  const checkoutSubmit = document.getElementById("checkout-submit");
  const checkoutMessage = document.getElementById("checkout-message");

  checkoutButton?.addEventListener("click", () => {
    const order = getOrderSummary();
    if (!order.items.length || !checkoutForm) return;
    checkoutForm.classList.remove("hidden");
    checkoutForm.scrollIntoView({ behavior: "smooth", block: "nearest" });
    checkoutForm.querySelector('input[name="name"]')?.focus();
  });

checkoutForm?.addEventListener("submit", async (event) => {
  event.preventDefault();
  if (!checkoutForm.reportValidity()) return;

  const order = getOrderSummary();
  if (!order.items.length) {
    if (checkoutMessage) {
      checkoutMessage.textContent = "Your cart is empty.";
      checkoutMessage.className = "text-sm text-red-600";
    }
    return;
  }

  const formData = new FormData(checkoutForm);
  const client = {
    name: String(formData.get("name") || "").trim(),
    phone: String(formData.get("phone") || "").trim(),
    address: String(formData.get("address") || "").trim(),
  };

  const prods = getCart();
  const odr = prods.map((e)=>{return { sku: e.id, qte: e.quantity, prix: e.price }});
  const clientData = {
    store_phone: info.phone,
    order_id: '001',
    customer_name: `${client.name} - ${info.phone}`,
    adresse: client.address,
    details: odr
  };

  if (checkoutSubmit) checkoutSubmit.disabled = true;
  if (checkoutMessage) {
    checkoutMessage.textContent = "Sending your order…";
    checkoutMessage.className = "text-sm text-gray-600";
  }

  try {
    const res = await fetch(CHECKOUT_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(clientData),
    });

    if (!res.ok) {
      throw new Error(`Order request failed (${res.status})`);
    }

    if (checkoutMessage) {
      checkoutMessage.textContent = "Order submitted. Opening WhatsApp…";
      checkoutMessage.className = "text-sm text-green-700";
    }
    //openWhatsApp(makeWhatsAppMessage(order, client));
  } catch (error) {
    console.error("Checkout request failed:", error);
    if (checkoutMessage) {
      checkoutMessage.textContent = "Could not submit the order. Please check your connection and try again.";
      checkoutMessage.className = "text-sm text-red-600";
    }
  } finally {
    if (checkoutSubmit) checkoutSubmit.disabled = false;
  }
});

/* Initial render */
renderCart();
/* Listen to changes from other components */
window.addEventListener("cart-updated", () => renderCart());
/* Handle changes from another browser tab */
window.addEventListener("storage", (event) => {
  if (event.key === CART_KEY) renderCart();
});
</script>
