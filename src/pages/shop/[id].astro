---
import Layout from "../../layouts/Layout.astro";
import { products } from "../../data/products";
import Navbar from '../../ui/navbar.astro';
import Footer from "../../ui/footer.astro";
import { info } from "../../data/products.ts";
import { IconSend2, IconChevronDown, IconMessagePlus } from '@tabler/icons-astro';

export function getStaticPaths() {
  return products.map((product) => ({ params: { id: String(product.id) }, props: { product }}));
}

const { product } = Astro.props;
const siteUrl = import.meta.env.SITE;
const productUrl = `${siteUrl}shop/${product.id}`;
const reviewScriptUrl  = 'https://script.google.com/macros/s/AKfycbzOXDncBkj2-qnrccSu8Asz-Hn9yy0xjSIE0ytlEE8Y8hBPGbcXXBpdQ6rRtJkQOGAH/exec'//'https://script.google.com/macros/s/AKfycbzfcAd_VQZLDGsxZ0dvDmmCISwptPNtrqVBU1E38GDt4-ZMfp9-e1g4ZeQC6fGI5idu/exec';
const productName = product.id;
---

<Layout
  title={`${product.name} | ${info.name.toUpperCase()}`}
  description={product.shortDescription}
  canonical={productUrl}
  image={product.images[0]}
  product={product}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Shop", url: "/shop" },
    { name: product.category, url: `/shop?category=${product.category}` },
    { name: product.name, url: productUrl },
  ]}
>
<Navbar />

  <main class="bg-white dark:bg-gray-950">
    <!-- Breadcrumb -->
    <div class="border-b border-gray-100 dark:border-gray-800">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
          <a href=`${import.meta.env.BASE_URL}` class="transition hover:text-indigo-600 dark:hover:text-indigo-400"> Home </a>
          <span>/</span>
          <a href=`${import.meta.env.BASE_URL}shop` class="transition hover:text-indigo-600 dark:hover:text-indigo-400"> Shop </a>
          <span>/</span>
          <span class="truncate text-gray-900 dark:text-gray-200"> {product.name} </span>
        </nav>
      </div>
    </div>

    <!-- Product -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
        <!-- ================= IMAGES ================= -->
        <div>
          <!-- Main Image -->
          <div class="relative aspect-square overflow-hidden rounded-2xl bg-gray-100 dark:bg-gray-900" >
            <img id="main-image" src={`${import.meta.env.BASE_URL}${product.images[0]}`} alt={product.name} class="h-full w-full object-cover" />
            {
              product.oldPrice && (
                <span class="absolute inset-s-4 top-4 rounded-full bg-red-500 px-3 py-1.5 text-xs font-semibold text-white"> Sale </span>
              )
            }
          </div>

          <!-- Thumbnails -->
          <div class="mt-4 grid grid-cols-4 gap-3">
            {
              product.images.map((image, index) => (
                <button type="button" data-image={`${import.meta.env.BASE_URL}${image}`} class:list={[ "product-thumbnail aspect-square overflow-hidden rounded-lg border-2 dark:bg-gray-900", index === 0 ? "border-indigo-600 dark:border-indigo-500" : "border-transparent", ]} >
                  <img src={`${import.meta.env.BASE_URL}${image}`} alt={`${product.name} ${index + 1}`} class="h-full w-full object-cover" />
                </button>
              ))
            }
          </div>
        </div>
        <!-- ================= INFO ================= -->
        <div class="flex flex-col">
          <!-- Category -->
          <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400">{product.category}</p>
          <!-- Title -->
          <h1
            class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl"
          >
            {product.name}
          </h1>
          <!-- Rating -->
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-1">
              <div class="flex text-yellow-400">
                {
                  Array.from({ length: 5 }).map(() => (
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                      <path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
                    </svg>
                  ))
                }
              </div>
              <span class="text-sm font-semibold text-gray-900 dark:text-gray-200"
                >{product.rating}</span
              >
            </div>
            <span class="text-sm text-gray-400 dark:text-gray-500"
              >({product.reviews} reviews)</span
            >
          </div>
          <!-- Price -->
          <div class="mt-6 flex items-center gap-3">
            <span class="text-3xl font-bold text-gray-900 dark:text-gray-100"
              >${product.price.toFixed(2)}</span
            >
            {
              product.oldPrice && (
                <span class="text-lg text-gray-400 line-through dark:text-gray-500">
                  ${product.oldPrice.toFixed(2)}
                </span>
              )
            }
          </div>
          <!-- Description -->
          <div class="mt-6 border-t border-gray-100 dark:border-gray-800 pt-6">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-200">Description</h2>
            <p class="mt-3 text-sm leading-7 text-gray-600 dark:text-gray-400">
              {product.description}
            </p>
          </div>
          <!-- Features -->
          <div class="mt-6">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-200">Features</h2>
            <ul class="mt-3 space-y-2">
              {
                product.features.map((feature) => (
                  <li class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <svg class="h-4 w-4 shrink-0 text-green-500 dark:text-green-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" />
                    </svg>
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Stock -->
          <div class="mt-6">
            {
              product.stock > 0 ? (
                <p class="flex items-center gap-2 text-sm font-medium text-green-600 dark:text-green-400">
                  <span class="h-2 w-2 rounded-full bg-green-500 dark:bg-green-400" />
                  In stock · {product.stock} available
                </p>
              ) : (
                <p class="text-sm font-medium text-red-500 dark:text-red-400">Out of stock</p>
              )
            }
          </div>

          <!-- Colors -->
          <div class="mt-6">
            {
              product.colors && product.colors.length > 0 && (
                <div>
                  <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-200">Colors</h2>
                  <div class="mt-3 flex items-center gap-3">
                    {
                      product.colors.length>0 && product.colors.map((color) => (
                        <button type="button" class="flex size-10 items-center justify-center rounded-full border border-gray-200 text-gray-500 hover:border-indigo-500 hover:text-indigo-500 dark:border-gray-700 dark:hover:border-indigo-400" aria-label={color.name} >
                          <span class={`h-full w-full rounded-full border border-gray-200 dark:border-gray-700`} style={`background-color: ${color.value}`}/>
                        </button>
                      )
                    )}
                  </div>
                </div>
              )
            }
          </div>

          <!-- Quantity + Cart -->
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <!-- Quantity -->
            <div class="flex h-12 w-full items-center justify-between rounded-lg border border-gray-200 dark:border-gray-800 dark:bg-gray-900 sm:w-32" >
              <button id="decrease" type="button" class="flex h-full w-10 items-center justify-center text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200" >
                −
              </button>

              <span id="quantity" class="text-sm font-semibold text-gray-900 dark:text-gray-200"> 1 </span>

              <button id="increase" type="button" class="flex h-full w-10 items-center justify-center text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200" >
                +
              </button>
            </div>

            <!-- Add cart -->
            <button
              id="add-to-cart"
              type="button"
              class="flex min-h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-6 text-sm font-semibold text-white transition hover:bg-indigo-700 active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-gray-300 dark:disabled:bg-gray-800 dark:disabled:text-gray-600"
              disabled={product.stock <= 0}
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" />
                <circle cx="10" cy="20" r="1" /><circle cx="18" cy="20" r="1" />
              </svg>

              <span id="add-to-cart-text">
                {product.stock > 0 ? "Add to cart" : "Out of stock"}
              </span>
            </button>

            <!-- Wishlist -->
            <button type="button" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-gray-200 text-gray-500 transition hover:border-red-200 hover:text-red-500 dark:border-gray-800 dark:text-gray-400 dark:hover:border-red-900 dark:hover:text-red-400" aria-label="Add to wishlist" >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.8 8.7c0 5.5-8.8 10.3-8.8 10.3S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.1a4.7 4.7 0 0 1 8.8 2.6Z" ></path>
              </svg>
            </button>
          </div>

          <!-- Benefits -->
          <div class="mt-8 grid grid-cols-1 gap-4 border-t border-gray-100 dark:border-gray-800 pt-6 sm:grid-cols-3" >
            <!-- Free Shipping -->
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-900" >
                <svg class="h-5 w-5 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"></path>
                  <circle cx="7" cy="19" r="1.5"></circle>
                  <circle cx="18" cy="19" r="1.5"></circle>
                </svg>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-900 dark:text-gray-200">Free Shipping</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Orders over $50</p>
              </div>
            </div>

            <!-- Easy Returns -->
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-900" >
                <svg class="h-5 w-5 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4v6h6"></path>
                </svg>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-900 dark:text-gray-200">Easy Returns</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">30 days return</p>
              </div>
            </div>

            <!-- Secure Payment -->
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-900" >
                <svg class="h-5 w-5 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 5 6v5c0 4.5 3 7.5 7 10 4-2.5 7-5.5 7-10V6z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"></path>
                </svg>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-900 dark:text-gray-200"> Secure Payment </p>
                <p class="text-xs text-gray-500 dark:text-gray-400">100% secure</p>
              </div>
            </div>
          </div>
          <!-- Product Content -->
        </div>
      </div>
    </section>

    <!-- Reviews party from google-->
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <section id="reviews" class="border-t border-gray-200 bg-gray-50 py-10 dark:border-gray-800 dark:bg-gray-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mt-8 flex flex-col gap-5">
          
          <div id="review-model" class="rounded-2xl">
            
            <div id="googleLoginWrapper" class="flex flex-col items-center justify-center rounded-xl border border-dashed border-gray-300 p-6 text-center dark:border-gray-700">
              <p class="mb-3 text-sm text-gray-600 dark:text-gray-400">يرجى تسجيل الدخول بحساب Google لتشترك برأيك حول هذا المنتج:</p>
              <div id="buttonDiv"></div>
            </div>

            <form id="productReviewForm" class="hidden">
              <input type="hidden" id="productNameInput" name="ProductName" value="اسم المنتج الحالي" />
              <input type="hidden" id="hiddenName" name="CustomerName" />
              <input type="hidden" id="hiddenEmail" name="email" />
              <input type="hidden" id="hiddenPic" name="CustomerPic" />
              
              <div class="flex gap-1 items-end">
                <img id="userPicImg" src="" alt="صورة المستخدم" crossorigin="anonymous" referrerpolicy="no-referrer" class="size-16 min-w-16 rounded-full border border-gray-300 object-cover">
                
                <div class="flex flex-col w-full">
                  <label id="userNameLabel" for="review-comment" class="mt-2 mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
                  <textarea id="review-comment" name="Comment" placeholder="Tell us what you think about this product..." required maxlength="2000"
                    class="w-full h-16 resize-y rounded-lg border border-gray-300 bg-white px-3 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder:text-gray-500"
                  ></textarea>
                </div>

                <button id="submitBtn" type="submit" class="rtl:rotate-180 flex items-center justify-center rounded-full bg-indigo-600 p-3 font-semibold text-white transition hover:bg-indigo-700 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-60">
                  <IconSend2 />
                </button>
              </div>

              <p id="responseMessage" class="hidden mt-3 rounded-lg px-3 py-2 text-sm" role="status" aria-live="polite"></p>
            </form>

          </div>
          
          <!-- قسم عرض التعليقات والآراء -->
          <div class="lg:col-span-2">
            <div class="flex flex-col gap-2 border-b border-gray-200 pb-5 dark:border-gray-800 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                  What customers say
                </h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                  Reviews submitted for this product.
                </p>
              </div>
              <span id="reviewsCount" class="text-sm text-gray-500 dark:text-gray-400">Loading reviews…</span>
            </div>

            <div id="loadingReviews" class="mt-5 rounded-xl border border-gray-200 bg-white px-5 py-8 text-center text-sm text-gray-500 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400">
              Loading reviews…
            </div>

            <div id="reviewsList" class="mt-5 space-y-4"></div>
          </div>

        </div>
      </div>
    </section>


    <script define:vars={{ productName, reviewScriptUrl }}>

      const GOOGLE_CLIENT_ID = "733687980644-vi4o228feo26o6v9j6rgs55ihj9k5cbi.apps.googleusercontent.com";
      const APPS_SCRIPT_URL = reviewScriptUrl; 

      document.getElementById('productNameInput').value = productName;

      function decodeJwtResponse(token) {
        try {
          var base64Url = token.split('.')[1];
          var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
          var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) { return '%' + ('0' + c.charCodeAt(0).toString(16)).slice(-2)}).join(''));
          return JSON.parse(jsonPayload);
        } catch (e) {
          console.error("JWT Error:", e); return null;
        }
      }

      function handleCredentialResponse(response) {
        const payload = decodeJwtResponse(response.credential);
        if (!payload) return;

        // استخراج بيانات المستخدم
        const name = payload.name;
        const email = payload.email;
        const picture = payload.picture;

        // تحديث الواجهة بنفس التصميم المحدد
        document.getElementById('userNameLabel').innerText = name;
        document.getElementById('userPicImg').src = picture;

        // تعبئة الحقول المخفية
        document.getElementById('hiddenName').value = name;
        document.getElementById('hiddenEmail').value = email;
        document.getElementById('hiddenPic').value = picture;

        // إخفاء زر تسجيل الدخول وإظهار النموذج
        document.getElementById('googleLoginWrapper').classList.add('hidden');
        document.getElementById('productReviewForm').classList.remove('hidden');
      }

      window.onload = function () {
        if (typeof google !== 'undefined') {
          google.accounts.id.initialize({
            client_id: GOOGLE_CLIENT_ID, callback: handleCredentialResponse
          });

          google.accounts.id.renderButton(
            document.getElementById("buttonDiv"), { theme: "outline", size: "large", shape: "pill" }
          );
        }
        loadReviews();
      };

      function loadReviews() {
        const reviewsList = document.getElementById('reviewsList');
        const loadingReviews = document.getElementById('loadingReviews');
        const reviewsCount = document.getElementById('reviewsCount');

        fetch(`${APPS_SCRIPT_URL}?ProductName=${encodeURIComponent(productName)}`)
          .then(res => res.json())
          .then(data => {
            loadingReviews.classList.add('hidden');
            reviewsList.innerHTML = '';

            if (!data || data.length === 0) {
              reviewsCount.innerText = '0 reviews';
              reviewsList.innerHTML = `
                <div class="rounded-xl border border-gray-200 bg-white p-5 text-center text-sm text-gray-500 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400">
                  No reviews yet for this product. Be the first to leave one!
                </div>`;
              return;
            }

            reviewsCount.innerText = `${data.length} review${data.length > 1 ? 's' : ''}`;

            data.reverse().forEach(review => {
              const item = document.createElement('div');
              console.log("Review:", review);
              item.className = "flex gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900";
              item.innerHTML = `
                <img src="${review.image || 'https://via.placeholder.com/40'}" alt="${review.name}" crossorigin="anonymous" referrerpolicy="no-referrer" class="size-10 rounded-full border border-gray-200 object-cover dark:border-gray-700">
                <div class="flex flex-col w-full">
                  <div class="flex items-center justify-between">
                    <h4 class="text-sm font-semibold text-gray-900 dark:text-gray-100">${review.name}</h4>
                    <span class="text-xs text-gray-400">${new Date(review.date).toLocaleDateString()}</span>
                  </div>
                  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">${review.comment}</p>
                </div>
              `;
              reviewsList.appendChild(item);
            });
          })
          .catch(err => {
            loadingReviews.innerText = 'Failed to load reviews.';
          });
      }

      const form = document.getElementById('productReviewForm');
      const msg = document.getElementById('responseMessage');
      const btn = document.getElementById('submitBtn');

      form.addEventListener('submit', e => {
        e.preventDefault();
        btn.disabled = true;

        fetch(APPS_SCRIPT_URL, { method: 'POST', body: new FormData(form) })
          .then(res => res.json())
          .then(data => {
            msg.className = "mt-3 rounded-lg px-3 py-2 text-sm bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 block";
            msg.innerText = "Thank you! Your review has been submitted.";
            document.getElementById('review-comment').value = '';
            btn.disabled = false;
            loadReviews();
          })
          .catch(err => {
            msg.className = "mt-3 rounded-lg px-3 py-2 text-sm bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 block";
            msg.innerText = "Error sending review. Please try again.";
            btn.disabled = false;
          });
      });
    </script>
    <!-- Reviews party end -->
  </main>

  <Footer/>
</Layout>

<script>
  // Image gallery
  const mainImage = document.getElementById("main-image");
  const thumbnails = document.querySelectorAll<HTMLButtonElement>(".product-thumbnail");

  thumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener("click", () => {
      const image = thumbnail.dataset.image;

      if (image && mainImage) {
        mainImage.setAttribute("src", image);
      }

      thumbnails.forEach((item) => {
        item.classList.remove("border-indigo-600");
        item.classList.add("border-transparent");
      });

      thumbnail.classList.remove("border-transparent");
      thumbnail.classList.add("border-indigo-600");
    });
  });

  // Quantity
  const quantityElement = document.getElementById("quantity");
  const decrease = document.getElementById("decrease");
  const increase = document.getElementById("increase");

  let quantity = 1;

  decrease?.addEventListener("click", () => {
    if (quantity > 1) {
      quantity--;

      if (quantityElement) {
        quantityElement.textContent = String(quantity);
      }
    }
  });

  increase?.addEventListener("click", () => {
    quantity++;

    if (quantityElement) {
      quantityElement.textContent = String(quantity);
    }
  });
</script>

<script define:vars={{ productId: product.id, stock: product.stock }}>
  const CART_KEY = "shop_cart";

  const addToCartButton = document.getElementById("add-to-cart");
  const addToCartText = document.getElementById("add-to-cart-text");


  function getCart() {
    try { return JSON.parse(localStorage.getItem(CART_KEY) || "[]");} 
    catch {return [];}
  }


  function saveCart(cart) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent("cart-updated"));
  }


  function updateCartCount() {
    const countElement = document.getElementById("itemsCount");
    if (!countElement) return;

    const count = getCart()?.length;
    countElement.textContent = String(count);
    countElement.classList.toggle("hidden", count === 0);
  }


  addToCartButton?.addEventListener("click", () => {
    if (stock <= 0) return;
    const cart = getCart();

    const existingItem = cart.find((item) => item.id === productId);
    const qte = document.getElementById("quantity"); 
    const quantity = parseInt(qte?.textContent || "1", 10);

    if (existingItem) {
      if (existingItem.quantity < stock) { existingItem.quantity++; }
    } 
    else { cart.push({ id: productId, quantity: quantity, }); }

    saveCart(cart);

    updateCartCount();

    if (addToCartText) { addToCartText.textContent = "Added to cart"; }


    addToCartButton?.classList.remove( "bg-indigo-600" );

    addToCartButton?.classList.add("bg-green-600");

    setTimeout(() => {
      if (addToCartText) { addToCartText.textContent = "Add to cart";}
      addToCartButton?.classList.remove("bg-green-600");
      addToCartButton?.classList.add("bg-indigo-600");
    }, 800);
  });
  updateCartCount();
</script>
