---
import Layout from "../../layouts/Layout.astro";
import { products } from "../../data/products";
import Navbar from '../../ui/navbar.astro';
import Footer from "../../ui/footer.astro";

export function getStaticPaths() {
  return products.map((product) => ({ params: { id: String(product.id) }, props: { product }}));
}

const { product } = Astro.props;
const siteUrl = "https://example.com";
const productUrl = `${siteUrl}/shop/${product.id}`;
---

<Layout
  title={`${product.name} | SHOP.`}
  description={product.shortDescription}
  canonical={productUrl}
  image={product.images[0]}
  product={product}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Shop", url: "/shop" },
    { name: product.category, url: `/shop?category=${product.category}` },
    { name: product.name, url: productUrl },
  ]}
>
<Navbar />
  <main class="bg-white">
    <!-- Breadcrumb -->
    <div class="border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-sm text-gray-500">
          <a href=`${import.meta.env.BASE_URL}` class="transition hover:text-indigo-600"> Home </a>
          <span>/</span>
          <a href=`${import.meta.env.BASE_URL}shop` class="transition hover:text-indigo-600"> Shop </a>
          <span>/</span>
          <span class="truncate text-gray-900"> {product.name} </span>
        </nav>
      </div>
    </div>

    <!-- Product -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
        <!-- ================= IMAGES ================= -->
        <div>
          <!-- Main Image -->
          <div class="relative aspect-square overflow-hidden rounded-2xl bg-gray-100" >
            <img id="main-image" src={product.images[0]} alt={product.name} class="h-full w-full object-cover" />
            {
              product.oldPrice && (
                <span class="absolute inset-s-4 top-4 rounded-full bg-red-500 px-3 py-1.5 text-xs font-semibold text-white"> Sale </span>
              )
            }
          </div>

          <!-- Thumbnails -->
          <div class="mt-4 grid grid-cols-4 gap-3">
            {
              product.images.map((image, index) => (
                <button type="button" data-image={image} class:list={[ "product-thumbnail aspect-square overflow-hidden rounded-lg border-2", index === 0 ? "border-indigo-600" : "border-transparent", ]} >
                  <img src={image} alt={`${product.name} ${index + 1}`} class="h-full w-full object-cover" />
                </button>
              ))
            }
          </div>
        </div>
        <!-- ================= INFO ================= -->
        <div class="flex flex-col">
          <!-- Category -->
          <p class="text-sm font-medium text-indigo-600">{product.category}</p>
          <!-- Title -->
          <h1
            class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
          >
            {product.name}
          </h1>
          <!-- Rating -->
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-1">
              <div class="flex text-yellow-400">
                {
                  Array.from({ length: 5 }).map(() => (
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                      <path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
                    </svg>
                  ))
                }
              </div>
              <span class="text-sm font-semibold text-gray-900"
                >{product.rating}</span
              >
            </div>
            <span class="text-sm text-gray-400"
              >({product.reviews} reviews)</span
            >
          </div>
          <!-- Price -->
          <div class="mt-6 flex items-center gap-3">
            <span class="text-3xl font-bold text-gray-900"
              >${product.price.toFixed(2)}</span
            >
            {
              product.oldPrice && (
                <span class="text-lg text-gray-400 line-through">
                  ${product.oldPrice.toFixed(2)}
                </span>
              )
            }
          </div>
          <!-- Description -->
          <div class="mt-6 border-t border-gray-100 pt-6">
            <h2 class="text-sm font-semibold text-gray-900">Description</h2>
            <p class="mt-3 text-sm leading-7 text-gray-600">
              {product.description}
            </p>
          </div>
          <!-- Features -->
          <div class="mt-6">
            <h2 class="text-sm font-semibold text-gray-900">Features</h2>
            <ul class="mt-3 space-y-2">
              {
                product.features.map((feature) => (
                  <li class="flex items-center gap-2 text-sm text-gray-600">
                    <svg class="h-4 w-4 shrink-0 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" />
                    </svg>
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Stock -->
          <div class="mt-6">
            {
              product.stock > 0 ? (
                <p class="flex items-center gap-2 text-sm font-medium text-green-600">
                  <span class="h-2 w-2 rounded-full bg-green-500" />
                  In stock · {product.stock} available
                </p>
              ) : (
                <p class="text-sm font-medium text-red-500">Out of stock</p>
              )
            }
          </div>

          <!-- Quantity + Cart -->
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <!-- Quantity -->
            <div class="flex h-12 w-full items-center justify-between rounded-lg border border-gray-200 sm:w-32" >
              <button id="decrease" type="button" class="flex h-full w-10 items-center justify-center text-gray-500 hover:text-gray-900" >
                −
              </button>

              <span id="quantity" class="text-sm font-semibold text-gray-900"> 1 </span>

              <button id="increase" type="button" class="flex h-full w-10 items-center justify-center text-gray-500 hover:text-gray-900" >
                +
              </button>
            </div>

            <!-- Add cart -->
            <button
              id="add-to-cart"
              type="button"
              class="flex min-h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-6 text-sm font-semibold text-white transition hover:bg-indigo-700 active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-gray-300"
              disabled={product.stock <= 0}
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" />
                <circle cx="10" cy="20" r="1" /><circle cx="18" cy="20" r="1" />
              </svg>

              <span id="add-to-cart-text">
                {product.stock > 0 ? "Add to cart" : "Out of stock"}
              </span>
            </button>

            <!-- Wishlist -->
            <button type="button" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-gray-200 text-gray-500 transition hover:border-red-200 hover:text-red-500" aria-label="Add to wishlist" >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.8 8.7c0 5.5-8.8 10.3-8.8 10.3S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.1a4.7 4.7 0 0 1 8.8 2.6Z" ></path>
              </svg>
            </button>
          </div>

          <!-- Benefits -->
          <div class="mt-8 grid grid-cols-1 gap-4 border-t border-gray-100 pt-6 sm:grid-cols-3" >
            <!-- Free Shipping -->
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100" >
                <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"></path>
                  <circle cx="7" cy="19" r="1.5"></circle>
                  <circle cx="18" cy="19" r="1.5"></circle>
                </svg>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-900">Free Shipping</p>
                <p class="text-xs text-gray-500">Orders over $50</p>
              </div>
            </div>

            <!-- Easy Returns -->
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100" >
                <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4v6h6"></path>
                </svg>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-900">Easy Returns</p>
                <p class="text-xs text-gray-500">30 days return</p>
              </div>
            </div>

            <!-- Secure Payment -->
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100" >
                <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 5 6v5c0 4.5 3 7.5 7 10 4-2.5 7-5.5 7-10V6z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"></path>
                </svg>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-900"> Secure Payment </p>
                <p class="text-xs text-gray-500">100% secure</p>
              </div>
            </div>
          </div>
          <!-- Product Content -->
        </div>
      </div>
    </section>
  </main>
  <Footer/>
</Layout>

<script>
  // Image gallery
  const mainImage = document.getElementById("main-image");
  const thumbnails =
    document.querySelectorAll<HTMLButtonElement>(".product-thumbnail");

  thumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener("click", () => {
      const image = thumbnail.dataset.image;

      if (image && mainImage) {
        mainImage.setAttribute("src", image);
      }

      thumbnails.forEach((item) => {
        item.classList.remove("border-indigo-600");
        item.classList.add("border-transparent");
      });

      thumbnail.classList.remove("border-transparent");
      thumbnail.classList.add("border-indigo-600");
    });
  });

  // Quantity
  const quantityElement = document.getElementById("quantity");
  const decrease = document.getElementById("decrease");
  const increase = document.getElementById("increase");

  let quantity = 1;

  decrease?.addEventListener("click", () => {
    if (quantity > 1) {
      quantity--;

      if (quantityElement) {
        quantityElement.textContent = String(quantity);
      }
    }
  });

  increase?.addEventListener("click", () => {
    quantity++;

    if (quantityElement) {
      quantityElement.textContent = String(quantity);
    }
  });
</script>

<script define:vars={{ productId: product.id, stock: product.stock }}>
  const CART_KEY = "shop_cart";

  const addToCartButton = document.getElementById("add-to-cart");
  const addToCartText = document.getElementById("add-to-cart-text");


  function getCart() {
    try { return JSON.parse(localStorage.getItem(CART_KEY) || "[]");} 
    catch {return [];}
  }


  function saveCart(cart) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent("cart-updated"));
  }


  function updateCartCount() {
    const countElement = document.getElementById("itemsCount");
    if (!countElement) return;

    const count = getCart()?.length;
    countElement.textContent = String(count);
    countElement.classList.toggle("hidden", count === 0);
  }


  addToCartButton?.addEventListener("click", () => {
    if (stock <= 0) return;
    const cart = getCart();

    const existingItem = cart.find((item) => item.id === productId);
    const qte = document.getElementById("quantity"); 
    const quantity = parseInt(qte?.textContent || "1", 10);

    if (existingItem) {
      if (existingItem.quantity < stock) { existingItem.quantity++; }
    } 
    else { cart.push({ id: productId, quantity: quantity, }); }

    saveCart(cart);

    updateCartCount();

    if (addToCartText) { addToCartText.textContent = "Added to cart"; }


    addToCartButton?.classList.remove( "bg-indigo-600" );

    addToCartButton?.classList.add("bg-green-600");

    setTimeout(() => {
      if (addToCartText) { addToCartText.textContent = "Add to cart";}
      addToCartButton?.classList.remove("bg-green-600");
      addToCartButton?.classList.add("bg-indigo-600");
    }, 800);
  });
  updateCartCount();
</script>
