<script> 
  const searchButton = document.getElementById("mobile-search-button"); 
  const searchPanel = document.getElementById("mobile-search"); 
  const searchInput = document.getElementById("mobile-search-input"); 
  const menuButton = document.getElementById("menu-btn"); 
  const menu = document.getElementById("mobile-menu"); 
  const menuPath = document.getElementById("menu-icon-path"); 
  /* * Mobile search */ 
  searchButton?.addEventListener("click", () => { 
    if (!searchPanel) return; 
    const isHidden = searchPanel.classList.contains("hidden"); 
    searchPanel.classList.toggle("hidden", !isHidden); 
    searchButton.setAttribute("aria-expanded", String(isHidden)); 
    if (isHidden) { searchInput?.focus(); } 
  }); 
  /* * Mobile menu */ 
  menuButton?.addEventListener("click", () => { 
    if (!menu) return; 
    const isHidden = menu.classList.contains("hidden"); 
    menu.classList.toggle("hidden", !isHidden); 
    menuButton.setAttribute("aria-expanded", String(isHidden)); 
    if (isHidden) { 
      menuButton.setAttribute("aria-label", "Close menu"); 
      menuPath?.setAttribute( "d", "M6 6l12 12M18 6 6 18" ); 
    } else { 
      menuButton.setAttribute("aria-label", "Open menu"); 
      menuPath?.setAttribute( "d", "M4 6h16M4 12h16M4 18h16" ); 
    } 
  }); 
  /* * Cart */ 
  function getCart() { 
    try { const stored = localStorage.getItem("shop_cart"); 
    if (!stored) return []; const parsed = JSON.parse(stored); 
    return Array.isArray(parsed) ? parsed : []; } 
    catch { return []; } 
  } 
  function updateCartCount() { 
    const countElement = document.getElementById("itemsCount"); 
    if (!countElement) return; 
    const cart = getCart(); 
    const count = cart.reduce((total, item) => { 
      const quantity = Number(item?.quantity); 
      return total + (Number.isFinite(quantity) && quantity > 0 ? quantity : 0); 
    }, 0); 
    countElement.textContent = String(count); countElement.classList.toggle("hidden", count === 0); 
  } 
  updateCartCount(); 
  /* * Update the count whenever another component changes the cart. */ 
  window.addEventListener("cart-updated", updateCartCount); 
  window.addEventListener("storage", (event) => { if (event.key === "shop_cart") { updateCartCount(); } }); 
</script>
