---
import { info } from "../data/products";
---

<nav class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur w-full">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6  justify-between lg:px-8">

    <!-- Logo -->
    <a href=`${import.meta.env.BASE_URL}` class="shrink-0 text-2xl font-black tracking-tight text-gray-900"> {info.name}<span class="text-indigo-600">.</span> </a>

    <!-- Desktop Navigation -->
    <div class="hidden items-center gap-7 md:flex">
      <a href=`${import.meta.env.BASE_URL}` class="text-sm font-medium text-gray-900 transition hover:text-indigo-600"> Home </a>
      <a href=`${import.meta.env.BASE_URL}shop` class="text-sm font-medium text-gray-600 transition hover:text-indigo-600"> Shop </a>
      <a href=`${import.meta.env.BASE_URL}shop` class="text-sm font-medium text-gray-600 transition hover:text-indigo-600"> Categories </a>
      <a href=`${import.meta.env.BASE_URL}shop` class="text-sm font-medium text-gray-600 transition hover:text-indigo-600"> New Arrivals </a>
      <!-- <a href=`${import.meta.env.BASE_URL}sale` class="text-sm font-medium text-red-500 transition hover:text-red-600">
        Sale
      </a> -->
    </div>

    <!-- Search -->
    <div class="ml-auto hidden max-w-md flex-1 lg:block">
      <div role="search" class="relative">
        <svg class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" >
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
        </svg>
        <input type="search" id="csr-search" placeholder="Search products..." class="h-10 w-full rounded-lg border border-gray-200 bg-gray-50 pl-10 pr-4 text-sm outline-none transition focus:border-indigo-500 focus:bg-white" />
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-1">

      <!-- Search Mobile -->
      <!--<button class="rounded-lg p-2 text-gray-600 transition hover:bg-gray-100 hover:text-gray-900 lg:hidden" aria-label="Search" >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
        </svg>
      </button>-->

      <!-- Account -->
      <a href="/account" class="hidden rounded-lg p-2 text-gray-600 transition hover:bg-gray-100 hover:text-gray-900 sm:block" aria-label="Account" >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4" />
          <path stroke-linecap="round" d="M4 21c.8-4 3.4-6 8-6s7.2 2 8 6" />
        </svg>
      </a>

      <!-- Wishlist -->
      <a href="/wishlist" class="hidden rounded-lg p-2 text-gray-600 transition hover:bg-gray-100 hover:text-gray-900 sm:block" aria-label="Wishlist" >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.8 8.7c0 5.5-8.8 10.3-8.8 10.3S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.1a4.7 4.7 0 0 1 8.8 2.6Z" />
        </svg>
      </a>

      <!-- Cart -->
      <a href=`${import.meta.env.BASE_URL}cart` class="relative rounded-lg p-2 text-gray-600 transition hover:bg-gray-100 hover:text-gray-900" aria-label="Shopping cart" >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" />
          <circle cx="10" cy="20" r="1" />
          <circle cx="18" cy="20" r="1" />
        </svg>

        <span id="itemsCount" class="absolute -right-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-indigo-600 px-1 text-[10px] font-bold text-white" >
          2
        </span>
      </a>

      <!-- Mobile Menu -->
      <button id="menu-btn" class="rounded-lg p-2 text-gray-600 transition hover:bg-gray-100 md:hidden" aria-label="Open menu" aria-expanded="false" >
        <svg id="menu-icon" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"> <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /> </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white md:hidden" >
    <div class="space-y-1 bg-gray-200 px-4 py-4">
      <a href=`${import.meta.env.BASE_URL}` class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-50"> Home </a>
      <a href=`${import.meta.env.BASE_URL}shop` class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50"> Shop </a>
      <a href=`${import.meta.env.BASE_URL}shop` class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50"> Categories </a>
      <a href=`${import.meta.env.BASE_URL}shop` class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50"> New Arrivals </a>
      <a href=`${import.meta.env.BASE_URL}sale` class="block rounded-lg px-3 py-2.5 text-sm font-medium text-red-500 hover:bg-red-50"> Sale </a>
    </div>
  </div>
</nav>


