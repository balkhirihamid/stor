---
import { info } from "../data/products";
---

<!-- Footer -->
<footer class="border-t border-gray-200 bg-white w-full mt-10">
  <!-- Main Footer -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="text-xl font-bold tracking-tight text-gray-900">{info.name}.</a>
        <p class="mt-4 max-w-xs text-sm leading-6 text-gray-500">
          Discover quality products designed for everyday life.
          Simple, modern and made with you in mind.
        </p>

        <!-- Social -->
        <div class="mt-6 flex items-center gap-3">
          <a href="#" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-gray-900 hover:text-gray-900" > <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"> <path d="M13.5 8H16V4h-2.5C10.5 4 9 5.7 9 8.5V11H6v4h3v5h4v-5h3l.5-4H13v-2.2c0-.6.2-.8.5-.8Z" /> </svg> </a>
          <a href="#" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-gray-900 hover:text-gray-900" >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>

          <a href="#" aria-label="TikTok" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-gray-900 hover:text-gray-900" >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"> <path d="M15.5 3c.3 2.2 1.5 3.6 3.5 3.8v3.1c-1.4-.1-2.6-.5-3.5-1.2v6.4c0 3.5-2.5 5.9-6 5.9-3.2 0-5.5-2.2-5.5-5.2 0-3.3 2.7-5.6 6.4-5.6v3.2c-1.8-.1-3.1.8-3.1 2.3 0 1.2.9 2.1 2.2 2.1 1.5 0 2.3-1 2.3-2.9V3h3.7Z" /> </svg>
          </a>

          <a href="#" aria-label="X" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-gray-900 hover:text-gray-900" >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"> <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.4l-5-6.6L6 22H2.9l7.2-8.2L2.4 2H9l4.5 6L18.9 2Zm-1.1 17.6h1.8L8.9 4.3H7L17.8 19.6Z" /> </svg>
          </a>

        </div>

      </div>


      <!-- Shop -->
      <div>
        <h2 class="text-sm font-semibold text-gray-900"> Shop </h2>
        <ul class="mt-4 space-y-3">
          <li> <a href="/shop" class="text-sm text-gray-500 transition hover:text-gray-900" > All Products </a> </li>
          <li> <a href="/shop?category=Clothing" class="text-sm text-gray-500 transition hover:text-gray-900" > Clothing </a> </li>
          <li> <a href="/shop?category=Shoes" class="text-sm text-gray-500 transition hover:text-gray-900" > Shoes </a> </li>
          <li> <a href="/shop?category=Accessories" class="text-sm text-gray-500 transition hover:text-gray-900" > Accessories </a> </li>
        </ul>
      </div>

      <!-- Help -->
      <div>
        <h2 class="text-sm font-semibold text-gray-900"> Help </h2>
        <ul class="mt-4 space-y-3">
          <li> <a href="/contact" class="text-sm text-gray-500 transition hover:text-gray-900" > Contact Us </a> </li>
          <li> <a href="/shipping" class="text-sm text-gray-500 transition hover:text-gray-900" > Shipping & Delivery </a> </li>
          <li> <a href="/returns" class="text-sm text-gray-500 transition hover:text-gray-900" > Returns & Refunds </a> </li>
          <li> <a href="/faq" class="text-sm text-gray-500 transition hover:text-gray-900" > FAQ </a> </li>
        </ul>
      </div>


      <!-- Company -->
      <div>
        <h2 class="text-sm font-semibold text-gray-900"> Company </h2>
        <ul class="mt-4 space-y-3">
          <li> <a href="/about" class="text-sm text-gray-500 transition hover:text-gray-900" > About Us </a> </li>
          <li> <a href="/privacy" class="text-sm text-gray-500 transition hover:text-gray-900" > Privacy Policy </a> </li>
          <li> <a href="/terms" class="text-sm text-gray-500 transition hover:text-gray-900" > Terms & Conditions </a> </li>
          <li> <a href="/cookies" class="text-sm text-gray-500 transition hover:text-gray-900" > Cookie Policy </a> </li>
        </ul>
      </div>
    </div>


    <!-- Newsletter -->
    <div class="mt-12 border-t border-gray-100 pt-10">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"> Subscribe to our newsletter </h2>
          <p class="mt-1 text-sm text-gray-500"> Get updates about new products and special offers. </p>
        </div>


        <form class="flex w-full max-w-md gap-2">
          <label for="footer-email" class="sr-only"> Email address </label>
          <input
            id="footer-email"
            type="email"
            name="email"
            placeholder="Your email address"
            autocomplete="email"
            required
            class="h-11 min-w-0 flex-1 rounded-lg border border-gray-200 px-4 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900"
          />

          <button type="submit" class="h-11 shrink-0 rounded-lg bg-gray-900 px-5 text-sm font-semibold text-white transition hover:bg-gray-800" > Subscribe </button>
        </form>
      </div>
    </div>
  </div>


  <!-- Bottom Footer -->
  <div class="border-t border-gray-100">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <p class="text-xs text-gray-500"> © {new Date().getFullYear()} {info.name}. All rights reserved. </p>
      <div class="flex items-center gap-4">
        <span class="text-xs text-gray-400"> Secure payments </span>
        <div class="flex items-center gap-2 text-gray-400">
          <span class="rounded border border-gray-200 px-2 py-1 text-[10px] font-semibold"> VISA </span>
          <span class="rounded border border-gray-200 px-2 py-1 text-[10px] font-semibold"> MC </span>
          <span class="rounded border border-gray-200 px-2 py-1 text-[10px] font-semibold"> AMEX </span>
        </div>
      </div>
    </div>
  </div>
</footer>