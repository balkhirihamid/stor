---
// import astroLogo from '../assets/astro.svg';
// import background from '../assets/background.svg';
// import Layout from "../layouts/Layout.astro";
import { products } from "../data/products";
---


  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gray-950 text-white">
      <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:px-8 lg:py-28">

        <!-- Hero Content -->
        <div class="max-w-2xl">

          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-400">
            New Collection
          </p>

          <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            Designed for everyday life.
          </h1>

          <p class="mt-6 max-w-xl text-base leading-7 text-gray-300 sm:text-lg">
            Discover carefully selected clothing, shoes and accessories
            designed to combine quality, comfort and modern style.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">

            <a
              href={`${import.meta.env.BASE_URL}shop`}
              class="inline-flex h-12 items-center justify-center rounded-lg bg-white px-6 text-sm font-semibold text-gray-900 transition hover:bg-gray-100"
            >
              Shop now
            </a>

            <a
              href="#featured"
              class="inline-flex h-12 items-center justify-center rounded-lg border border-gray-700 px-6 text-sm font-semibold text-white transition hover:bg-gray-900"
            >
              Explore collection
            </a>

          </div>

        </div>

        <!-- Hero Image -->
        <div class="relative">

          <div class="aspect-square overflow-hidden rounded-3xl bg-gray-800">

            <img
              src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1200"
              alt="SHOP. premium fashion collection"
              width="1200"
              height="1200"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />

          </div>

        </div>

      </div>
    </section>


    <!-- Benefits -->
    <section class="border-b border-gray-100 bg-white">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 py-8 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">

        <!-- Free Shipping -->
        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v10H3zM14 10h4l3 3v4h-7z" />
              <circle cx="7" cy="19" r="1.5" />
              <circle cx="18" cy="19" r="1.5" />
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-900">
              Free Shipping
            </p>

            <p class="text-xs text-gray-500">
              On orders over $50
            </p>
          </div>

        </div>

        <!-- Easy Returns -->
        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4v6h6" />
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-900">
              Easy Returns
            </p>

            <p class="text-xs text-gray-500">
              30 days return
            </p>
          </div>

        </div>

        <!-- Secure Payment -->
        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 5 6v5c0 4.5 3 7.5 7 10 4-2.5 7-5.5 7-10V6z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" />
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-900">
              Secure Payment
            </p>

            <p class="text-xs text-gray-500">
              100% secure checkout
            </p>
          </div>

        </div>

        <!-- Support -->
        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 10a6 6 0 0 0-12 0v4a2 2 0 0 0 2 2h2v-6H6M18 10v6h-2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 16a3 3 0 0 1-3 3h-2" />
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-900">
              Customer Support
            </p>

            <p class="text-xs text-gray-500">
              We're here to help
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- Featured Products -->
    <section id="featured" class="bg-gray-50">

      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">

        <!-- Section Header -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

          <div>

            <p class="text-sm font-semibold text-indigo-600">
              Our collection
            </p>

            <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
              Featured products
            </h2>

            <p class="mt-2 max-w-xl text-sm leading-6 text-gray-500">
              Explore some of our most popular products.
            </p>

          </div>

          <a
            href="/shop"
            class="inline-flex items-center text-sm font-semibold text-indigo-600 transition hover:text-indigo-700"
          >
            View all products
            <span class="ms-2" aria-hidden="true">→</span>
          </a>

        </div>


        <!-- Product Grid -->
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-4 lg:gap-x-8">

          {products.slice(0, 8).map((product) => (

            <article class="group">

              <!-- Product Image -->
              <a
                href={`${import.meta.env.BASE_URL}shop/${product.id}`}
                class="relative block aspect-square overflow-hidden rounded-xl bg-gray-100"
              >

                <img
                  src={`${import.meta.env.BASE_URL}${product.images[0]}`}
                  alt={product.name}
                  width="800"
                  height="800"
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />

                {product.oldPrice && (
                  <span class="absolute start-3 top-3 rounded-full bg-red-500 px-2.5 py-1 text-xs font-semibold text-white">
                    Sale
                  </span>
                )}

              </a>


              <!-- Product Info -->
              <div class="mt-4">

                <p class="text-xs font-medium text-indigo-600">
                  {product.category}
                </p>

                <h3 class="mt-1 truncate text-sm font-semibold text-gray-900">
                  <a
                    href={`${import.meta.env.BASE_URL}shop/${product.id}`}
                    class="transition hover:text-indigo-600"
                  >
                    {product.name}
                  </a>
                </h3>


                <!-- Rating -->
                <div class="mt-2 flex items-center gap-2">

                  <div class="flex text-yellow-400">

                    {Array.from({ length: 5 }).map(() => (
                      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
                        <path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
                      </svg>
                    ))}

                  </div>

                  <span class="text-xs text-gray-500">
                    ({product.reviews})
                  </span>

                </div>


                <!-- Price -->
                <div class="mt-2 flex items-center gap-2">

                  <span class="text-sm font-bold text-gray-900">
                    ${product.price.toFixed(2)}
                  </span>

                  {product.oldPrice && (
                    <span class="text-xs text-gray-400 line-through">
                      ${product.oldPrice.toFixed(2)}
                    </span>
                  )}

                </div>

              </div>

            </article>

          ))}

        </div>

      </div>

    </section>


    <!-- Category Banner -->
    <section class="bg-white">

      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 overflow-hidden rounded-3xl bg-gray-100 lg:grid-cols-2">

          <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-16">

            <p class="text-sm font-semibold text-indigo-600">
              Everyday essentials
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
              Simple products.
              <br />
              Better everyday.
            </h2>

            <p class="mt-5 max-w-lg text-sm leading-7 text-gray-600">
              From comfortable clothing to practical accessories,
              discover products selected to fit naturally into your
              everyday lifestyle.
            </p>

            <div class="mt-8">

              <a
                href="/shop"
                class="inline-flex h-11 items-center justify-center rounded-lg bg-gray-900 px-6 text-sm font-semibold text-white transition hover:bg-gray-800"
              >
                Browse products
              </a>

            </div>

          </div>


          <div class="min-h-[320px]">

            <img
              src="https://images.unsplash.com/photo-1445205170230-053b83016050?w=1200"
              alt="SHOP. everyday fashion collection"
              width="1200"
              height="800"
              loading="lazy"
              class="h-full w-full object-cover"
            />

          </div>

        </div>

      </div>

    </section>

  </main>

<!-- SEO Product List -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Featured Products",
  "url": "https://example.com/",
  "numberOfItems": products.length,
  "itemListElement": products.slice(0, 8).map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://example.com/products/${product.id}`,
    "name": product.name
  }))
})} />
